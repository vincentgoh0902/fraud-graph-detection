# Copy to .env and fill in. .env is git-ignored; never commit it.

# Neo4j (used by docker-compose and the app)
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-to-something-long
NEO4J_URI=bolt://localhost:7687

# Host ports for docker compose (optional; defaults 8000 and 8501).
# API_HOST_PORT=8000
# DASHBOARD_HOST_PORT=8501

# Kaggle: store your token in ~/.kaggle/access_token (outside the repo),
# or uncomment and set it here instead.
# KAGGLE_API_TOKEN=
